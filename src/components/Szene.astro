---
// Dekorative Hintergrund-Szenen (eigene Vektorgrafiken, themenbezogen: Café, Laden, Straße mit Betrieben, Team, Lieferdienst).
// Nur Farb-Tokens, kein Fremdmaterial, wenige KB. "ton" = hell (auf Beige) oder dunkel (auf Tiefgrün).
// Wo echte Fotos gewünscht sind: Dateien in AUSFUELLEN/bilder legen und die Szene durch ein <img> ersetzen.
interface Props { art: "cafe" | "laden" | "strasse" | "team" | "lieferung"; ton?: "hell" | "dunkel"; klasse?: string }
const { art, ton = "hell", klasse = "" } = Astro.props;
