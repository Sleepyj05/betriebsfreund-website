---
// Bestätigung nach dem Absenden des Formulars (Netlify leitet hierher weiter).
import Base from "../layouts/Base.astro";
import { kontakt, telHref, whatsappHref } from "../config";
---
<Base titel="Danke für Ihre Anfrage | Betriebsfreund" noindex ohneLeiste>
  <section class="danke abschnitt">
    <div class="wrap">
      <div class="kopfzeile"><svg class="logo-gross" viewBox="0 0 100 100" role="img" aria-label="Betriebsfreund Logo"><circle cx="50" cy="50" r="50" fill="#1E4D40"/><g fill="#fff"><rect x="29" y="24" width="14" height="52"/><rect x="29" y="24" width="42" height="23" rx="11.5"/><rect x="29" y="52" width="46" height="24" rx="12"/></g><circle cx="21" cy="72" r="5.5" fill="#A8D5BA"/></svg>
      <div class="haken" aria-hidden="true">✓</div></div>
      <h1>Danke. <span class="mark">Ich melde mich.</span></h1>
      <p class="lead">Ich rufe Sie {kontakt.antwortFrist} zurück. Ihre Angaben sind bei mir angekommen.</p>
      <p class="lead">Es eilt? Ich bin auch direkt erreichbar ({kontakt.zeiten}):</p>
      <div class="knoepfe">
        <a class="btn btn-primaer btn-gross" href={telHref}>Jetzt anrufen: {kontakt.telefon}</a>
        <a class="btn btn-zweit btn-gross" href={whatsappHref} target="_blank" rel="noopener">WhatsApp schreiben</a>
      </div>
      <p class="zurueck"><a class="textlink" href="/">Zurück zur Startseite</a></p>
    </div>
  </section>
</Base>

<style>
  .danke { min-height: 70vh; }
  .kopfzeile { display: flex; align-items: center; gap: 16px; margin-bottom: 28px; }
  .logo-gross { width: 76px; height: 76px; display: block; flex: none; }
  .wrap { max-width: 720px; }
  .haken { width: 76px; height: 76px; border-radius: 50%; background: var(--erfolg); color: var(--creme); display: grid; place-items: center; font-size: 2.25rem; font-weight: 800; flex: none; }
  h1 { font-size: clamp(2.5rem, 10vw, 4.5rem); }
  .lead { margin-top: 18px; font-size: 1.1875rem; color: var(--grau); max-width: 44ch; }
  .knoepfe { display: grid; gap: 12px; margin-top: 24px; max-width: 460px; }
  .zurueck { margin-top: 28px; }
</style>
