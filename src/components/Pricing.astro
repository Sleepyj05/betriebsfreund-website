---
// Preise: zwei Pakete (Basis, Plus) + EIN gemeinsamer Countdown bis zum Ende des Gründerpreises.
// Daten stehen in src/config.ts → preise. Nach Ablauf blendet sich der Gründerpreis automatisch aus,
// es erscheint der reguläre Preis (bzw. ab Startdatum der Neukundenpreis, falls aktiviert).
// Der Countdown startet NIE neu – er rechnet nur gegen das feste Datum.
import { preise, steuerHinweis, gruenderAktivBeimBau } from "../config";

interface Props {
  /** kompakte Variante ohne Überschrift (z. B. auf /demo) */
  kompakt?: boolean;
}
const { kompakt = false } = Astro.props;
const g = preise.gruender;
const alle = preise.pakete;
---
<section class:list={["preis-abschnitt", { abschnitt: !kompakt }]} id={kompakt ? undefined : "preise"} aria-labelledby={kompakt ? undefined : "preise-titel"}
  data-bis={g.bis}>
  <div class:list={["wrap", { kompakt }]}>
    {!kompakt && <h2 id="preise-titel" class="reveal preis-h2">Ein Preis. Für Ihren <span class="mark">ganzen Betrieb.</span></h2>}
    {!kompakt && <p class="lead reveal">Zwei Pakete, beide monatlich kündbar. Im Dezember zum Gründerpreis.</p>}

    <div class="pakete">
      {alle.map((p, i) => (
        <article class:list={["karte", "dunkel", "reveal", { top: p.hervorgehoben }]} style={`--d:${i * 0.1}s`}
          data-paket={p.id} data-regulaer={p.regulaer} data-neukunde={p.neukunde.aktiv ? p.neukunde.betrag : ""} data-neukunde-ab={p.neukunde.ab}>
          <h3 class="p-name">{p.name}</h3>
          <p class="p-sub">{p.untertitel}</p>

          <div data-gruender hidden={!gruenderAktivBeimBau}>
            <p class="etikett">{g.etikett}</p>
            <p class="gross">{g.zeitraum} für <span class="betrag">{p.gruender}</span></p>
            <p class="danach">danach <strong data-regulaer-preis>{p.regulaer}</strong> {preise.zusatz}</p>
          </div>
          <div data-regulaer-block hidden={gruenderAktivBeimBau}>
            <p class="gross"><span class="betrag" data-regulaer-gross>{p.regulaer}</span> <span class="pro">pro Monat</span></p>
            <p class="danach">monatlich kündbar · keine Mindestlaufzeit</p>
          </div>

          <ul class="haken">
            {i > 0 && <li class="alles"><strong>Alles aus {alle[0].name}</strong></li>}
            {p.leistungen.map((l) => <li>{l}</li>)}
          </ul>

          <a href={`/?paket=${p.id}#kontakt`} class="btn btn-gelb btn-gross voll">
            <span data-gruender hidden={!gruenderAktivBeimBau}>Gründerpreis sichern</span>
            <span data-regulaer-block hidden={gruenderAktivBeimBau}>Paket anfragen</span>
          </a>
        </article>
      ))}
    </div>

    <div class="countdown" data-gruender hidden={!gruenderAktivBeimBau}>
      <p class="cd-titel">Gründerpreis endet am {g.kurzDatum} um 23:59 Uhr, noch:</p>
      <div class="cd" role="timer" aria-label="Verbleibende Zeit bis zum Ende des Gründerpreises">
        <div><b data-cd="t">–</b><span>Tage</span></div>
        <div><b data-cd="h">–</b><span>Std.</span></div>
        <div><b data-cd="m">–</b><span>Min.</span></div>
        <div><b data-cd="s">–</b><span>Sek.</span></div>
      </div>
    </div>

    <p class="klein">{steuerHinweis[preise.steuer]}</p>
  </div>
</section>

<style>
  .preis-abschnitt { scroll-margin-top: 70px; }
  .preis-h2 { max-width: 16ch; }
  .lead { margin-top: 14px; color: var(--grau); font-size: 1.125rem; }
  .pakete { margin-top: 32px; display: grid; gap: 20px; }
  .karte { background: var(--schiefer); color: #fff; border-radius: 28px; padding: 30px 24px; display: grid; gap: 4px; align-content: start; box-shadow: var(--schatten); position: relative; }
  .karte.top { outline: 4px solid var(--akzent); outline-offset: -4px; }
  .p-name { font-size: 1.5rem; color: #fff; }
  .p-sub { color: #CBD0D5; margin-bottom: 14px; min-height: 2.8em; }
  .etikett { display: inline-block; background: var(--akzent); color: var(--schiefer); font-weight: 800; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 7px 12px; border-radius: 99px; }
  .gross { margin-top: 16px; font-size: clamp(2rem, 9vw, 2.75rem); font-weight: 800; letter-spacing: -0.045em; line-height: 1.02; }
  .betrag { color: var(--akzent); }
  .pro { font-size: 0.4em; letter-spacing: -0.01em; font-weight: 700; color: #CBD0D5; }
  .danach { margin-top: 10px; color: #CBD0D5; }
  .danach strong { color: #fff; }
  .haken { list-style: none; margin: 24px 0; padding: 22px 0 0; border-top: 1px solid rgba(255, 255, 255, 0.16); display: grid; gap: 12px; }
  .haken li { display: grid; grid-template-columns: 26px 1fr; gap: 10px; align-items: start; }
  .haken li::before { content: "✓"; width: 24px; height: 24px; border-radius: 50%; background: var(--gruen); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 0.8125rem; margin-top: 1px; }
  .haken .alles::before { content: "+"; background: var(--akzent); color: var(--schiefer); }
  .voll { width: 100%; align-self: end; }
  .countdown { margin-top: 28px; text-align: center; max-width: 520px; margin-inline: auto; }
  .cd-titel { color: var(--schiefer); font-weight: 700; }
  .cd { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 12px; }
  .cd div { background: var(--schiefer); border-radius: 14px; padding: 12px 4px 10px; }
  .cd b { display: block; font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; color: var(--akzent); }
  .cd span { display: block; margin-top: 6px; font-size: 0.75rem; color: #AEB5BC; text-transform: uppercase; letter-spacing: 0.08em; }
  .klein { margin-top: 22px; font-size: 0.875rem; color: var(--grau); text-align: center; }
  @media (min-width: 900px) {
    .pakete { grid-template-columns: 1fr 1fr; gap: 28px; align-items: stretch; }
    .karte { padding: 40px; }
  }
</style>

<script>
  // Echter Countdown gegen das feste Enddatum aus der Config. Nach Ablauf wird der Gründerpreis ausgeblendet.
  document.querySelectorAll<HTMLElement>(".preis-abschnitt").forEach((box) => {
    const bis = Date.parse(box.dataset.bis!);
    const feld = (k: string) => box.querySelector<HTMLElement>(`[data-cd="${k}"]`);
    const zwei = (n: number) => String(n).padStart(2, "0");

    function tick() {
      const jetzt = Date.now();
      const rest = bis - jetzt;
      if (rest <= 0) {
        box.querySelectorAll<HTMLElement>("[data-gruender]").forEach((e) => (e.hidden = true));
        box.querySelectorAll<HTMLElement>("[data-regulaer-block]").forEach((e) => (e.hidden = false));
        // Neukundenpreis ab Startdatum (nur wenn in der Config aktiviert)
        box.querySelectorAll<HTMLElement>("[data-paket]").forEach((k) => {
          const n = k.dataset.neukunde, ab = Date.parse(k.dataset.neukundeAb || "");
          if (n && jetzt >= ab) k.querySelectorAll<HTMLElement>("[data-regulaer-gross],[data-regulaer-preis]").forEach((e) => (e.textContent = n));
        });
        return;
      }
      const s = Math.floor(rest / 1000);
      feld("t")!.textContent = String(Math.floor(s / 86400));
      feld("h")!.textContent = zwei(Math.floor((s % 86400) / 3600));
      feld("m")!.textContent = zwei(Math.floor((s % 3600) / 60));
      feld("s")!.textContent = zwei(s % 60);
      setTimeout(tick, 1000 - (Date.now() % 1000));
    }
    tick();
  });
</script>
