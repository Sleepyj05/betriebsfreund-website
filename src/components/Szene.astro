    </g>
  )}
  {art === "lieferung" && (
    <g>
      <rect class="b" x="0" y="372" width="1200" height="48" />
      <path d="M0 372h1200" style="fill:none;stroke:var(--a)" stroke-width="6" stroke-dasharray="40 30" />
      <circle cx="560" cy="330" r="44" fill="none" stroke-width="10" style="stroke:var(--a)" /><circle cx="800" cy="330" r="44" fill="none" stroke-width="10" style="stroke:var(--a)" />
      <path d="M560 330l60-110h100l80 110M620 220l-14-30h-34M720 220l-60 110M740 190h40" fill="none" stroke-width="10" stroke-linejoin="round" stroke-linecap="round" style="stroke:var(--b)" />
      <rect class="c" x="740" y="120" width="110" height="80" rx="10" /><path d="M740 156h110M795 120v80" stroke-width="8" style="fill:none;stroke:var(--a)" />
