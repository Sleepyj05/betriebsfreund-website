---
// Logo: B-Zeichen (grüner Kreis, weißes B, Mint-Punkt) + Name. Der Name kommt aus src/config.ts.
import { marke } from "../config";
---
<span class="logo"><svg class="logo-z" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><circle cx="50" cy="50" r="50" fill="#1E4D40"/><g fill="#fff"><rect x="29" y="24" width="14" height="52"/><rect x="29" y="24" width="42" height="23" rx="11.5"/><rect x="29" y="52" width="46" height="24" rx="12"/></g><circle cx="21" cy="72" r="5.5" fill="#A8D5BA"/></svg>{marke.name}</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.03em; }
  .logo-z { width: 28px; height: 28px; flex: none; }
  :global(.dunkel) .logo-z { box-shadow: 0 0 0 1.5px var(--creme); border-radius: 50%; }
</style>
