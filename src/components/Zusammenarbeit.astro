---
// Ersetzt den früheren "Über mich"-Bereich: zeigt in drei Schritten, wie die Zusammenarbeit läuft, und nennt die Zusagen,
// die Vertrauen schaffen. Lösungsorientiert, ohne persönliche Angaben, die erst vor Ort ergänzt werden.
import Icon from "./Icon.astro";
import { kontakt } from "../config";
const wege = [
  { titel: "Gespräch", text: "Sie erzählen kurz, wie Ihr Betrieb läuft und wo es hakt. Dann zeige ich Ihnen in wenigen Minuten, wie es einfacher geht." },
  { titel: "Einrichtung", text: "Ich richte Team, Schichten und Regeln gemeinsam mit Ihnen ein. Ihre Mitarbeiter werden per Link eingeladen." },
  { titel: "Es läuft", text: "Ihr Team nutzt die App, Sie geben nur noch frei. Bei Fragen erreichen Sie mich direkt, per Telefon oder WhatsApp." },
];
const zusagen = [
  { icon: "calendar", titel: "Monatlich kündbar", text: "Keine Mindestlaufzeit." },
  { icon: "server", titel: "Daten in Deutschland", text: "Server in Frankfurt." },
  { icon: "download", titel: "Ihre Daten gehören Ihnen", text: "Export jederzeit möglich." },
  { icon: "phone", titel: "Ein Ansprechpartner", text: `Direkt erreichbar, ${kontakt.zeiten}.` },
];
---
<section class="abschnitt" id="zusammenarbeit" aria-labelledby="zus-titel">
  <div class="wrap">
    <p class="eyebrow">So arbeiten wir zusammen</p>
    <h2 id="zus-titel" class="reveal">Von der ersten Frage bis zum <span class="mark">laufenden Plan.</span></h2>

    <ol class="wege">
      {wege.map((w, i) => (
        <li class="reveal" style={`--d:${i * 0.1}s`}>
          <span class="zahl" aria-hidden="true">{i + 1}</span>
          <h3>{w.titel}</h3>
          <p>{w.text}</p>
        </li>
      ))}
    </ol>

    <ul class="zusagen">
      {zusagen.map((z, i) => (
        <li class="reveal" style={`--d:${i * 0.06}s`}>
          <span class="ico"><Icon name={z.icon} size={24} /></span>
          <div><strong>{z.titel}</strong><span>{z.text}</span></div>
        </li>
      ))}
    </ul>
    <p class="aktion reveal"><a class="btn btn-gelb btn-gross" href="/#kontakt">Gespräch vereinbaren</a></p>
  </div>
</section>

<style>
  .eyebrow { margin-bottom: 14px; }
  .wege { list-style: none; margin: 36px 0 0; padding: 0; display: grid; gap: 14px; counter-reset: s; }
  .wege li { background: var(--karte); border-radius: var(--radius); padding: 26px; display: grid; gap: 8px; align-content: start; }
  .zahl { width: 48px; height: 48px; border-radius: 50%; background: var(--schiefer); color: var(--akzent); display: grid; place-items: center; font-weight: 800; font-size: 1.4rem; margin-bottom: 8px; }
  .wege p { color: var(--grau); }
  .zusagen { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 10px; }
  .zusagen li { display: flex; gap: 14px; align-items: center; padding: 14px 4px; border-bottom: 1px solid var(--linie); }
  .ico { flex: none; width: 44px; height: 44px; border-radius: 12px; border: 2px solid var(--akzent); display: grid; place-items: center; color: var(--schiefer); }
  .zusagen strong { display: block; }
  .zusagen span:not(.ico) { color: var(--grau); font-size: 0.9375rem; }
  .aktion { margin-top: 32px; }
  @media (min-width: 900px) {
    .wege { grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .zusagen { grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 28px; }
    .zusagen li { border: 0; border-top: 1px solid var(--linie); padding: 20px 0 0; align-items: flex-start; }
  }
</style>
