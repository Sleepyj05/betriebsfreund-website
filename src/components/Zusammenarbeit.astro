---
// "So arbeiten wir zusammen": Zeitleiste mit drei Stationen (statt Karten) und Zusagen als Chips.
// Lösungsorientiert, ohne persönliche Angaben, die erst vor Ort ergänzt werden.
import Icon from "./Icon.astro";
import Szene from "./Szene.astro";
import { kontakt } from "../config";
const wege = [
  { titel: "Gespräch", text: "Sie erzählen kurz, wie Ihr Betrieb läuft und wo es hakt. Dann zeige ich Ihnen in wenigen Minuten, wie es einfacher geht." },
  { titel: "Einrichtung", text: "Ich richte Team, Schichten und Regeln gemeinsam mit Ihnen ein. Ihre Mitarbeiter werden per Link eingeladen." },
  { titel: "Es läuft", text: "Ihr Team nutzt die App, Sie geben nur noch frei. Bei Fragen erreichen Sie mich direkt, per Telefon oder WhatsApp." },
];
const zusagen = [
  { icon: "calendar", titel: "Monatlich kündbar" },
  { icon: "server", titel: "Daten in Deutschland" },
  { icon: "download", titel: "Export jederzeit" },
  { icon: "phone", titel: `Direkt erreichbar, ${kontakt.zeiten}` },
];
---
<section class="abschnitt" id="zusammenarbeit" aria-labelledby="zus-titel">
  <Szene art="team" ton="hell" />
  <div class="wrap">
    <p class="eyebrow reveal">So arbeiten wir zusammen</p>
    <h2 id="zus-titel" class="reveal">Von der ersten Frage bis zum <span class="mark">laufenden Plan.</span></h2>

    <ol class="weg">
      {wege.map((w, i) => (
        <li class="reveal reveal-l" style={`--d:${i * 0.12}s`}>
          <span class="punkt" aria-hidden="true">{i + 1}</span>
          <div>
            <h3>{w.titel}</h3>
            <p>{w.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <ul class="chips">
      {zusagen.map((z, i) => (
        <li class="reveal reveal-z" style={`--d:${i * 0.07}s`}><Icon name={z.icon} size={20} /><span>{z.titel}</span></li>
      ))}
    </ul>
    <p class="aktion reveal"><a class="btn btn-primaer btn-gross" href="/#kontakt">Gespräch vereinbaren</a></p>
  </div>
</section>

<style>
  .eyebrow { margin-bottom: 14px; }
  .weg { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 0; position: relative; }
  .weg::before { content: ""; position: absolute; left: 23px; top: 24px; bottom: 24px; width: 2px; background: var(--sand-linie); }
  .weg li { display: grid; grid-template-columns: 48px 1fr; gap: 20px; padding-bottom: 32px; position: relative; }
  .weg li:last-child { padding-bottom: 0; }
  .punkt { width: 48px; height: 48px; border-radius: 50%; background: var(--tiefgruen); color: var(--mint); display: grid; place-items: center; font-weight: 800; font-size: 1.4rem; position: relative; z-index: 1; box-shadow: 0 0 0 6px var(--papier); }
  .weg p { color: var(--grau); margin-top: 6px; max-width: 46ch; }
  .chips { list-style: none; margin: 40px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .chips li { display: inline-flex; align-items: center; gap: 10px; background: var(--creme); border: 1.5px solid var(--sand-linie); border-radius: 99px; padding: 10px 18px 10px 14px; font-weight: 700; }
  .aktion { margin-top: 36px; }
  @media (min-width: 900px) {
    .weg { grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .weg::before { left: 24px; right: 24px; top: 23px; bottom: auto; width: auto; height: 2px; }
    .weg li { grid-template-columns: 1fr; gap: 20px; padding-bottom: 0; }
  }
</style>
