---
// Foto als sanfter Hintergrund eines Bereichs: zart eingeblendet, zum Text hin ausgeblendet, damit alles lesbar bleibt.
// Bilder liegen in src/assets/fotos. Astro erzeugt daraus automatisch kleine WebP/AVIF-Dateien.
import { Picture } from "astro:assets";
interface Props { bild: ImageMetadata; ort?: "oben-rechts" | "rechts" | "oben" | "unten-rechts"; alt?: string; deckkraft?: number }
const { bild, ort = "rechts", alt = "", deckkraft = 0.3 } = Astro.props;
---
<div class:list={["foto", ort]} style={`--deck:${deckkraft}`} aria-hidden="true">
  <Picture src={bild} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(min-width: 900px) 55vw, 100vw" alt={alt} loading="lazy" decoding="async" />
</div>

<style>
  .foto { position: absolute; z-index: -1; pointer-events: none; overflow: hidden; opacity: var(--deck); }
  .foto :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.35) contrast(0.95); }
  /* Handy: Streifen oben, nach unten ausgeblendet */
  .foto { left: 0; right: 0; top: 0; height: 340px; mask-image: linear-gradient(to bottom, var(--tiefgruen) 30%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, var(--tiefgruen) 30%, transparent 100%); }
  .unten-rechts { top: auto; bottom: 0; mask-image: linear-gradient(to top, var(--tiefgruen) 30%, transparent 100%); -webkit-mask-image: linear-gradient(to top, var(--tiefgruen) 30%, transparent 100%); }
  /* Desktop: rechte Hälfte, zum Text hin ausgeblendet */
  @media (min-width: 900px) {
    .foto { left: auto; right: 0; top: 0; bottom: 0; width: 46%; height: auto;
      mask-image: linear-gradient(to left, var(--tiefgruen) 30%, transparent 100%), linear-gradient(to top, transparent 0%, var(--tiefgruen) 28%, var(--tiefgruen) 72%, transparent 100%);
      mask-composite: intersect; -webkit-mask-image: linear-gradient(to left, var(--tiefgruen) 30%, transparent 100%), linear-gradient(to top, transparent 0%, var(--tiefgruen) 28%, var(--tiefgruen) 72%, transparent 100%); -webkit-mask-composite: source-in; }
    .oben-rechts { bottom: 22%; }
    .unten-rechts { top: 40%; bottom: 0; }
  }
</style>
