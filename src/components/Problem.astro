---
// Abschnitt 3: Das Problem – zurückhaltend gestaltet (leicht graue Karten), damit die Lösung danach heller wirkt.
import Icon from "./Icon.astro";
const karten = [
  { icon: "chat", text: "Der Plan hängt als Foto in der WhatsApp-Gruppe und keiner findet die aktuelle Version." },
  { icon: "phone", text: "Krankmeldung um 6 Uhr. Zehn Anrufe. Keiner geht ran." },
  { icon: "clock", text: "Wer hat wie viele Stunden? Passt das noch zur Minijob-Grenze? Keine Ahnung." },
];
---
<section class="abschnitt" aria-labelledby="problem-titel">
  <div class="wrap">
    <h2 id="problem-titel" class="reveal">Kommt Ihnen das <span class="mark">bekannt</span> vor?</h2>
    <ul class="karten">
      {karten.map((k, i) => (
        <li class="reveal" style={`--d:${i * 0.1}s`}>
          <span class="ico"><Icon name={k.icon} /></span>
          <p>{k.text}</p>
        </li>
      ))}
    </ul>
    <p class="weiter reveal">Dafür gibt es eine einfache Lösung. <a class="textlink" href="#so-funktionierts">So läuft es ab morgen ↓</a></p>
  </div>
</section>

<style>
  .karten { list-style: none; margin: 36px 0 0; padding: 0; display: grid; gap: 14px; }
  .karten li { background: var(--karte-grau); border-radius: var(--radius); padding: 24px; display: grid; gap: 14px; }
  .ico { width: 52px; height: 52px; border-radius: 14px; background: #d9d5ca; color: var(--grau); display: grid; place-items: center; }
  p { color: #3b4760; font-size: 1.125rem; font-weight: 500; line-height: 1.4; }
  .weiter { margin-top: 28px; color: var(--grau); }
  @media (min-width: 900px) { .karten { grid-template-columns: repeat(3, 1fr); gap: 20px; } .karten li { padding: 32px; } }
</style>
