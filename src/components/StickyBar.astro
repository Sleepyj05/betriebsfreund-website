---
// Fester Balken unten am Handy: Demo anfragen (mint) + Anrufen.
import { telHref, kontakt } from "../config";
---
<div class="leiste dunkel" role="region" aria-label="Schnellkontakt">
  <a href="/#kontakt" class="btn btn-primaer">Demo anfragen</a>
  <a href={telHref} class="btn btn-zweit leiste-tel" aria-label={`Anrufen: ${kontakt.telefon}`}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
    Anrufen
  </a>
</div>
<style>
  .leiste { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; display: grid; grid-template-columns: 1.4fr 1fr; gap: 10px; padding: 10px var(--rand) calc(10px + env(safe-area-inset-bottom)); background: var(--tiefgruen); border-top: 1px solid var(--linie-dunkel); }
  .leiste .btn { min-height: 56px; padding: 0 12px; }
  .leiste { transition: transform 0.3s ease; }
  .leiste.weg { transform: translateY(110%); }
  @media (min-width: 900px) { .leiste { display: none; } }
</style>

<script>
  // Der feste Balken verschwindet, sobald der Kontaktbereich im Bild ist (dort gibt es schon Formular und Telefon).
  const leiste = document.querySelector<HTMLElement>(".leiste");
  const kontakt = document.querySelector("#kontakt");
  if (leiste && kontakt && "IntersectionObserver" in window) {
    new IntersectionObserver(([e]) => leiste.classList.toggle("weg", e.isIntersecting), { threshold: 0.15 }).observe(kontakt);
  }
</script>
