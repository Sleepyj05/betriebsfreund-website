---
// Abschnitt 7: Rechner. Formel und Annahmen stehen in src/config.ts → rechner (dort dokumentiert, dort änderbar).
import { rechner as r } from "../config";
---
<section class="abschnitt" id="rechner" aria-labelledby="rechner-titel">
  <div class="wrap">
    <h2 id="rechner-titel" class="reveal">Was kostet Sie der Dienstplan <span class="mark">heute?</span></h2>
    <p class="lead reveal">Schieben Sie die Regler auf Ihren Betrieb. Sie sehen, wie viel Zeit Planung, Anrufe und Abstimmung im Monat kosten.</p>

    <div class="rechner reveal" data-rechner data-plan={r.planMinProMitarbeiterWoche} data-ausfall={r.minProAusfall} data-wochen={r.wochenProMonat}>
      <div class="regler">
        <label for="r-ma">Anzahl Mitarbeiter: <b data-out="ma">{r.standardMitarbeiter}</b></label>
        <input id="r-ma" type="range" min="3" max="60" step="1" value={r.standardMitarbeiter} data-in="ma" />
      </div>
      <div class="regler">
        <label for="r-au">Ausfälle oder Tausche pro Woche: <b data-out="au">{r.standardAusfaelle}</b></label>
        <input id="r-au" type="range" min="0" max="15" step="1" value={r.standardAusfaelle} data-in="au" />
      </div>
      <div class="regler">
        <label for="r-sa">Ihr Stundensatz: <b><span data-out="sa">{r.stundensatz}</span> €</b></label>
        <input id="r-sa" type="range" min="10" max="80" step="1" value={r.stundensatz} data-in="sa" />
      </div>

      <div class="ergebnis dunkel" aria-live="polite">
        <p class="e-zeile"><span class="zahl" data-res="std">–</span> <span>Stunden pro Monat für Planung und Abstimmung</span></p>
        <p class="e-zeile"><span class="zahl signal" data-res="eur">–</span> <span>Kosten Ihrer Zeit pro Monat</span></p>
      </div>
      <p class="fein">Grobe Schätzung. Angenommen: {r.planMinProMitarbeiterWoche} Min. Planung je Mitarbeiter und Woche, {r.minProAusfall} Min. je Ausfall oder Tausch. Ihr Betrieb kann abweichen.</p>
      <a class="btn btn-primaer" href="/#kontakt">Jetzt Demo anfragen</a>
    </div>
  </div>
</section>

<style>
  .lead { margin-top: 14px; color: var(--grau); max-width: 52ch; font-size: 1.125rem; }
  .rechner { margin-top: 32px; background: var(--creme); border-radius: 24px; padding: 26px 22px; display: grid; gap: 24px; max-width: 760px; }
  .regler { display: grid; gap: 10px; }
  label { font-weight: 600; }
  label b { font-weight: 800; }
  input[type="range"] { width: 100%; height: 44px; accent-color: var(--tiefgruen); cursor: pointer; background: transparent; }
  .ergebnis { background: var(--tiefgruen); border-radius: 18px; padding: 22px; display: grid; gap: 14px; color: var(--creme); }
  .e-zeile { display: grid; gap: 2px; }
  .zahl { font-size: clamp(2.25rem, 9vw, 3.25rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums; }
  .signal { color: var(--mint); }
  .e-zeile span:last-child { color: var(--auf-dunkel-leise); font-size: 0.9375rem; }
  .fein { font-size: 0.875rem; color: var(--grau); }
  .rechner .btn { justify-self: start; }
  @media (min-width: 900px) { .rechner { padding: 40px; } }
</style>

<script>
  // Rechnet live; nur Rechnen im Browser, nichts wird gesendet.
  document.querySelectorAll<HTMLElement>("[data-rechner]").forEach((box) => {
    const plan = Number(box.dataset.plan), ausfall = Number(box.dataset.ausfall), wochen = Number(box.dataset.wochen);
    const val = (k: string) => Number(box.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!.value);
    const out = (k: string, t: string) => (box.querySelector(`[data-out="${k}"]`)!.textContent = t);
    const res = (k: string, t: string) => (box.querySelector(`[data-res="${k}"]`)!.textContent = t);
    const nf = new Intl.NumberFormat("de-DE", { maximumFractionDigits: 0 });
    function rechne() {
      const ma = val("ma"), au = val("au"), sa = val("sa");
      const std = ((ma * plan) / 60 + (au * ausfall) / 60) * wochen;
      out("ma", String(ma)); out("au", String(au)); out("sa", String(sa));
      res("std", nf.format(Math.round(std)));
      res("eur", nf.format(Math.round((std * sa) / 10) * 10) + " €");
    }
    box.querySelectorAll("input").forEach((i) => i.addEventListener("input", rechne));
    rechne();
  });
</script>
