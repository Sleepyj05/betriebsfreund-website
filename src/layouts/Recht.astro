---
// Gemeinsames Layout für Impressum, Datenschutz, AGB, AV-Vertrag.
// WICHTIG: Die Inhalte sind VORLAGEN mit Platzhaltern und müssen vor dem Livegang ausgefüllt und rechtlich geprüft werden.
import Base from "./Base.astro";
import { rechtHinweis } from "../config";

interface Props { titel: string; beschreibung?: string }
const { titel, beschreibung } = Astro.props;
---
<Base titel={`${titel} | Ablaufklar`} beschreibung={beschreibung ?? `${titel} von Ablaufklar`}>
  <article class="abschnitt recht">
    <div class="wrap">
      <h1>{titel}</h1>
      <p class="warn" role="note"><strong>{rechtHinweis}</strong> Diese Seite ist eine Vorlage und kein verbindlicher Rechtstext. Stellen in [eckigen Klammern] müssen ausgefüllt werden.</p>
      <div class="text"><slot /></div>
    </div>
  </article>
</Base>

<style>
  .wrap { max-width: 760px; }
  h1 { font-size: clamp(2.25rem, 8vw, 3.5rem); margin-bottom: 24px; }
  .warn { background: #fff4cf; border: 2px solid var(--gelb); border-radius: 14px; padding: 14px 18px; margin-bottom: 36px; }
  .text :global(h2) { font-size: 1.5rem; letter-spacing: -0.025em; margin: 40px 0 10px; }
  .text :global(h3) { margin: 24px 0 6px; }
  .text :global(p), .text :global(ul) { margin-top: 10px; color: #2b3a55; }
  .text :global(ul) { padding-left: 22px; }
  .text :global(a) { font-weight: 600; }
  .text :global(.ph) { background: #fff4cf; padding: 1px 6px; border-radius: 5px; font-weight: 700; color: var(--navy); }
</style>
