---
// Hero: Aussage links, rechts bzw. darunter die Person aus dem Flyer mit Handy-Mockup.
import { Picture } from "astro:assets";
import person from "../assets/person.png";
import PhoneMock from "./PhoneMock.astro";
import { kontakt, telHref, demoLink } from "../config";
---
<section class="hero" aria-labelledby="hero-titel">
  <div class="wrap hero-in">
    <div class="hero-text">
      <p class="marke"><span class="marke-q" aria-hidden="true"></span>Schichtklar · die Dienstplan-App von Betriebsfreund</p>
      <h1 id="hero-titel">Mia ist krank.</h1>
      <p class="unter">Die App findet Ersatz. <span class="mark">Sie entscheiden mit einem Tipp.</span></p>
      <p class="klein">Die Dienstplan-App für jeden Betrieb, von Gastro bis Handel.</p>
      <div class="aktionen">
        <a href="/#kontakt" class="btn btn-gelb btn-gross">Demo in 2 Minuten ansehen</a>
        <a href={telHref} class="textlink">oder direkt anrufen: {kontakt.telefon}</a>
      </div>
      <p class="vertrauen">Server in Deutschland · monatlich kündbar · ich richte alles für Sie ein</p>
    </div>

    <div class="hero-bild">
      <div class="handy"><PhoneMock /></div>
      <figure class="person">
        <Picture
          src={person}
          formats={["avif", "webp"]}
          widths={[360, 520, 690]}
          sizes="(min-width: 900px) 330px, 52vw"
          alt="Eine Frau im Blazer zeigt mit offener Hand auf das Handy"
          width={690}
          height={687}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="ki">KI-generiertes Bild</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: 28px 56px; overflow-x: clip; }
  .hero-in { display: grid; gap: 36px; }
  .marke { display: inline-flex; align-items: center; gap: 10px; background: var(--karte); border-radius: 99px; padding: 8px 16px 8px 12px; font-weight: 700; font-size: 0.875rem; margin-bottom: 20px; }
  .marke-q { width: 12px; height: 12px; border-radius: 3px; background: var(--akzent); box-shadow: 0 0 0 2px var(--schiefer); }
  h1 { font-size: clamp(3rem, 13.5vw, 5.25rem); line-height: 0.98; letter-spacing: -0.045em; }
  .unter { margin-top: 18px; font-size: clamp(1.375rem, 5.2vw, 2rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.22; color: var(--grau); }
  .unter .mark { color: var(--schiefer); font-weight: 800; }
  .klein { margin-top: 18px; color: var(--grau); font-size: 1rem; }
  .aktionen { margin-top: 26px; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .aktionen .btn { width: 100%; }
  .vertrauen { margin-top: 12px; color: var(--grau); font-size: 0.9375rem; }

  /* Bildbereich: Handy rechts, Person links unten – überlappend wie auf dem Flyer */
  .hero-bild { position: relative; --phone-w: min(256px, 68vw); display: grid; padding-bottom: 8px; }
  .handy { width: var(--phone-w); justify-self: end; position: relative; z-index: 1; margin: 4px 10px 0 0; transform: rotate(3deg); transform-origin: 50% 80%; }
  .handy :global(.hinweis) { transform: rotate(-3deg); }
  .person { position: absolute; left: -18px; bottom: 74px; width: min(62vw, 330px); margin: 0; z-index: 2; pointer-events: none; }
  /* Unterkante weich ausblenden, damit das Foto nicht hart abgeschnitten wirkt */
  .person :global(img) { width: 100%; height: auto; -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 100%); mask-image: linear-gradient(to bottom, #000 78%, transparent 100%); }
  .ki { position: absolute; left: 22px; bottom: 6px; background: var(--schiefer); color: #fff; font-weight: 700; font-size: 0.875rem; padding: 7px 14px; border-radius: 99px; pointer-events: auto; }

  @media (min-width: 900px) {
    .hero { padding-block: 56px 96px; }
    .hero-in { grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 24px; }
    .aktionen { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 4px 24px; }
    .aktionen .btn { white-space: nowrap; }
    .aktionen .btn { width: auto; }
    .hero-bild { --phone-w: 270px; width: 100%; max-width: 480px; justify-self: end; }
    .person { width: 270px; left: 0; bottom: 76px; }
    .ki { left: 14px; }
  }
</style>
