---
// Logo: kleines gelbes Quadrat + Name. Der Name kommt aus src/config.ts.
import { produkt } from "../config";
---
<span class="logo"><span class="logo-q" aria-hidden="true"></span>{produkt.name}</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.03em; }
  .logo-q { width: 18px; height: 18px; border-radius: 5px; background: var(--gelb); box-shadow: 0 0 0 3px var(--navy); margin-right: 3px; }
  :global(.dunkel) .logo-q { box-shadow: 0 0 0 3px var(--navy-hell); }
</style>
