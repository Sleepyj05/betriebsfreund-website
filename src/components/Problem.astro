---
// Abschnitt 3: "Ja, das kenne ich"-Moment, aber lösungsorientiert: Jede Karte zeigt das Alltagsproblem UND gleich die Lösung.
import Icon from "./Icon.astro";
import Foto from "./Foto.astro";
import kalender from "../assets/fotos/kalender.jpg";
const karten = [
  { icon: "chat", problem: "Der Plan hängt als Foto in der WhatsApp-Gruppe und keiner findet die aktuelle Version.", loesung: "Ein Plan, immer aktuell, auf dem Handy jedes Mitarbeiters." },
  { icon: "phone", problem: "Krankmeldung um 6 Uhr. Zehn Anrufe. Keiner geht ran.", loesung: "Die App zeigt sofort, wer einspringen kann. Sie tippen nur auf „Freigeben“." },
  { icon: "clock", problem: "Wer hat wie viele Stunden? Passt das noch zur Minijob-Grenze?", loesung: "Die App warnt Sie, bevor es ein Problem wird." },
];
---
<section class="abschnitt" aria-labelledby="problem-titel">
  <Foto bild={kalender} ort="rechts" deckkraft={0.32} />
  <div class="wrap">
    <h2 id="problem-titel" class="reveal">Kennen Sie das? <span class="mark">Dafür gibt es eine Lösung.</span></h2>
    <ul class="karten">
      {karten.map((k, i) => (
        <li class="reveal" style={`--d:${i * 0.1}s`}>
          <span class="ico"><Icon name={k.icon} /></span>
          <p class="problem">„{k.problem}“</p>
          <p class="loesung"><span class="pfeil" aria-hidden="true">✓</span>{k.loesung}</p>
        </li>
      ))}
    </ul>
    <p class="weiter reveal"><a class="textlink" href="#so-funktionierts">So läuft es ab morgen ↓</a></p>
  </div>
</section>

<style>
  .karten { list-style: none; margin: 36px 0 0; padding: 0; display: grid; gap: 14px; }
  .karten li { background: var(--creme); border-radius: var(--radius); padding: 24px; display: grid; gap: 14px; align-content: start; }
  .ico { width: 52px; height: 52px; border-radius: 14px; background: var(--sand); color: var(--grau); display: grid; place-items: center; }
  .problem { color: var(--grau); font-size: 1.0625rem; font-weight: 500; line-height: 1.4; font-style: italic; }
  .loesung { display: grid; grid-template-columns: 26px 1fr; gap: 10px; font-size: 1.125rem; font-weight: 700; line-height: 1.35; padding-top: 14px; border-top: 1px solid var(--sand-linie); }
  .pfeil { width: 24px; height: 24px; border-radius: 50%; background: var(--erfolg-flaeche); color: var(--creme); display: grid; place-items: center; font-size: 0.8rem; font-weight: 800; margin-top: 1px; }
  .weiter { margin-top: 28px; }
  @media (min-width: 900px) { .karten { grid-template-columns: repeat(3, 1fr); gap: 20px; } .karten li { padding: 32px; } }
</style>
