---
// Kopfzeile: Logo links, auf dem Desktop Links, rechts der mintfarbene Hauptbutton. Am Handy nur Logo + Button.
import Logo from "./Logo.astro";
---
<header class="kopf">
  <div class="wrap kopf-in">
    <a href="/" class="kopf-logo" aria-label="Betriebsfreund, zur Startseite"><Logo /></a>
    <nav class="kopf-nav" aria-label="Hauptnavigation">
      <a href="/#so-funktionierts">So funktioniert's</a>
      <a href="/#leistungen">Mehr als Dienstplan</a>
      <a href="/#preise">Preise</a>
      <a href="/#faq">FAQ</a>
    </nav>
    <a href="/#kontakt" class="btn btn-primaer kopf-btn">Demo anfragen</a>
  </div>
</header>
<style>
  .kopf { position: sticky; top: 0; z-index: 50; background: var(--papier); }
  .kopf-in { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
  .kopf-logo { text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; }
  .kopf-nav { display: none; gap: 32px; }
  .kopf-nav a { text-decoration: none; font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
  .kopf-nav a:hover { text-decoration: underline; text-decoration-color: var(--mint); text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .kopf-btn { min-height: 46px; padding: 0 18px; font-size: 0.9375rem; }
  @media (min-width: 900px) { .kopf-nav { display: flex; } .kopf-btn { padding: 0 24px; } }
</style>
