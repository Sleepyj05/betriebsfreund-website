<style>
  .szene { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: min(62%, 520px); z-index: -1; pointer-events: none; }
  /* helle Variante (auf Beige): nur sehr helle Töne, damit Text darüber gut lesbar bleibt */
  .szene.hell { --a: var(--mint-hell); --b: var(--sand); --c: var(--creme); opacity: 0.85; }
  /* dunkle Variante (auf Tiefgrün): nur wenig heller als der Grund */
  .szene.dunkel { --a: var(--tiefgruen-hell); --b: color-mix(in srgb, var(--tiefgruen-hell) 55%, var(--tiefgruen)); --c: color-mix(in srgb, var(--creme) 9%, var(--tiefgruen-hell)); opacity: 0.8; }
  :global(.fuss) .szene { opacity: 0.5; }
  .a { fill: var(--a); } .b { fill: var(--b); } .c { fill: var(--c); }
</style>
