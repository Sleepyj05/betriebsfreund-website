      <rect class="b" x="230" y="90" width="150" height="330" /><rect class="c" x="252" y="120" width="30" height="40" rx="5" /><rect class="c" x="328" y="120" width="30" height="40" rx="5" /><rect class="c" x="252" y="190" width="30" height="40" rx="5" /><rect class="c" x="328" y="190" width="30" height="40" rx="5" /><rect class="a" x="286" y="318" width="44" height="102" rx="6" />
