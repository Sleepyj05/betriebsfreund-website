---
import Recht from "../layouts/Recht.astro";
import { kontakt, mailHref } from "../config";
const pdfs = Object.values(import.meta.glob("../../AUSFUELLEN/av-vertrag/*.pdf", { eager: true, query: "?url", import: "default" })) as string[];
const pdf = pdfs[0];
---
<Recht titel="Auftragsverarbeitungsvertrag (AV-Vertrag)">
  <p>Wenn Sie die Dienstplan-App für Ihren Betrieb nutzen, verarbeite ich Daten Ihrer Mitarbeiter in Ihrem Auftrag. Dafür schließen wir einen Auftragsverarbeitungsvertrag (AVV) nach Art. 28 DSGVO. Er ist im Preis enthalten.</p>

  <h2>Vertrag anfordern</h2>
  <p>Den Vertrag erhalten Sie auf Anfrage per E-Mail an <a href={mailHref}>{kontakt.email}</a> oder telefonisch unter {kontakt.telefon}.</p>

  <h2>PDF-Download</h2>
  {pdf ? <p><a class="btn btn-gelb" href={pdf} download>AV-Vertrag als PDF herunterladen</a></p> : <p><span class="ph">[PDF HIER ABLEGEN: Ordner AUSFUELLEN/av-vertrag, dann erscheint der Download-Link automatisch]</span></p>}
</Recht>
