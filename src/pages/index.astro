---
import WaIcon from "../components/WaIcon.astro";
// Neue, dunkle und animierte Startseite. Alle Texte, Preise und Kontaktdaten kommen weiter aus src/config.ts.
import { Picture } from "astro:assets";
import person from "../assets/person.png";
import Dunkel from "../layouts/Dunkel.astro";
import Hintergrund from "../components/Hintergrund.astro";
import DemoApp from "../components/DemoApp.astro";
import kalenderStift from "../assets/fotos/kalender-stift.jpg";
import bauplan from "../assets/fotos/bauplan.jpg";
import handKalender from "../assets/fotos/hand-kalender.jpg";
import { marke, produkt, seite, kontakt, preise, rechner, kennzahlen, weitereLeistungen, steuerHinweis, whatsappHref, telHref, mailHref, demoLink } from "../config";

const std = rechner;
const stundenBeispiel = (std.standardMitarbeiter * std.planMinProMitarbeiterWoche / 60 + std.standardAusfaelle * std.minProAusfall / 60) * std.wochenProMonat;
const ersparnisStd = Math.round(stundenBeispiel * kennzahlen.ersparnisAnteil);
const ersparnisEuro = Math.round(stundenBeispiel * kennzahlen.ersparnisAnteil * std.stundensatz);

const fragen = [
  { f: "Brauchen meine Mitarbeiter eine App aus dem App Store?", a: "Nein. Die App läuft im Browser und lässt sich mit einem Tipp auf den Startbildschirm legen. Nichts zu installieren." },
  { f: "Wo liegen die Daten?", a: "Auf Servern in Frankfurt am Main. Die DSGVO wird beachtet, einen Auftragsverarbeitungsvertrag bekommen Sie dazu." },
  { f: "Wie schnell bin ich startklar?", a: "Ich richte alles gemeinsam mit Ihnen ein: Team, Schichten, Einladungen. Meist geht das am selben Tag." },
  { f: "Was passiert nach dem Angebot?", a: `Danach kostet Basis 5 € pro Mitarbeiter und Monat (bei 10 Mitarbeitern ${preise.pakete[0].regulaer}) und Plus ${preise.pakete[1].regulaer} bei 10 Mitarbeitern. Monatlich kündbar, keine Mindestlaufzeit.` },
  { f: "Prüft die App wirklich das Arbeitszeitgesetz?", a: "Als Hinweis und Warnung: zu kurze Ruhezeiten, fehlende Pausen, zu lange Tage, Minijob-Grenze. Die Verantwortung bleibt beim Arbeitgeber. Keine Rechtsberatung." },
  { f: "Kann ich kündigen und meine Daten mitnehmen?", a: "Ja, jederzeit zum Monatsende. Plan und Teamdaten lassen sich als Tabelle exportieren." },
];
const schema = [
  { "@context": "https://schema.org", "@type": "SoftwareApplication", name: produkt.name, applicationCategory: "BusinessApplication", operatingSystem: "Web", inLanguage: "de",
    description: "Dienstplan-App für Betriebe mit Schichten: Krankmeldung, Schichttausch, Urlaub und automatische Regelprüfung.",
    offers: preise.pakete.map((p) => ({ "@type": "Offer", name: p.name, price: p.regulaer.replace(/[^\d,]/g, "").replace(",", "."), priceCurrency: "EUR" })),
    provider: { "@type": "Organization", name: marke.name } },
  { "@context": "https://schema.org", "@type": ["Organization", "LocalBusiness"], name: marke.name, url: seite.url, telephone: kontakt.telefon, email: kontakt.email,
    address: { "@type": "PostalAddress", addressLocality: kontakt.ort, addressCountry: "DE" }, areaServed: kontakt.ort, description: marke.slogan },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: fragen.map((x) => ({ "@type": "Question", name: x.f, acceptedAnswer: { "@type": "Answer", text: x.a } })) },
];
const branchen = ["Gastronomie", "Cafés", "Bäckereien", "Einzelhandel", "Hotels", "Friseure", "Pflegedienste", "Dienstleister"];
const paare = [
  { p: "Der Plan hängt als Foto in der WhatsApp-Gruppe und keiner findet die aktuelle Version.", l: "Ein Plan, immer aktuell, auf dem Handy jedes Mitarbeiters." },
  { p: "Krankmeldung um 6 Uhr. Zehn Anrufe. Keiner geht ran.", l: "Die App zeigt sofort, wer einspringen kann. Sie tippen nur auf „Freigeben“." },
  { p: "Wer hat wie viele Stunden? Passt das noch zur Minijob-Grenze?", l: "Die App warnt Sie, bevor es ein Problem wird." },
];
const tage = ["Mo", "Di", "Mi", "Do", "Fr"];
---
<Dunkel>
  <section class="hero" aria-labelledby="h1">
    <div class="orb a"></div><div class="orb b"></div><div class="orb c"></div><div class="gitter"></div>
    <div class="wrap">
      <div>
        <span class="kicker">{produkt.name} · der mitarbeiterfreundliche Dienstplan</span>
        <h1 id="h1">
          <span class="w"><span>Mia</span></span>
          <span class="w"><span>ist</span></span>
          <span class="w"><span class="grad">krank.</span></span>
        </h1>
        <p class="lead" style="font-weight:700;color:var(--text);font-size:clamp(1.3rem,3.4vw,1.9rem);line-height:1.25">Die App findet Ersatz.<br /><span class="grad">Sie tippen nur auf „Freigeben“.</span></p>
        <div class="knoepfe">
          <a class="btn" data-magnet href="#demo">Selbst ausprobieren →</a>
          <a class="btn leer" data-magnet href="#kontakt">Demo anfragen</a>
        </div>
        <p class="hinweis">Monatlich kündbar · Daten in Frankfurt · Ich richte alles für Sie ein</p>
      </div>
      <div class="buehne">
        <div class="handy" aria-hidden="true">
          <div class="schirm">
            <div class="titel"><span>Diese Woche</span><small>Mo 06:02</small></div>
            <div class="zeile"><span class="ava">M</span>Mara<span class="zeit">Früh 06–14</span></div>
            <div class="zeile" id="hk"><span class="ava">M</span>Mia<span class="zeit">Früh 06–14</span></div>
            <div class="zeile"><span class="ava">T</span>Tim<span class="zeit">Spät 14–22</span></div>
            <div class="zeile" id="he" style="display:none"><span class="ava">L</span>Lea<span class="zeit">Früh 06–14</span></div>
          </div>
          <div class="toast" id="ht">✓ Lea springt ein. Plan aktualisiert.</div>
        </div>
        <figure class="person">
          <Picture src={person} formats={["avif", "webp"]} widths={[360, 520, 690]} sizes="(min-width: 980px) 380px, 62vw" alt="Eine Frau im Blazer zeigt mit offener Hand auf das Handy" width={690} height={687} loading="eager" fetchpriority="high" />
          <figcaption class="ki">KI-generiertes Bild</figcaption>
        </figure>
        <span class="chip c1" aria-hidden="true">✓ Ersatz gefunden</span>
        <span class="chip c2" aria-hidden="true">Urlaub genehmigt</span>
        <span class="chip c3" aria-hidden="true">Plan veröffentlicht</span>
      </div>
    </div>
  </section>

  <div class="band" aria-hidden="true">
    <div class="laufband">
      {[...branchen, ...branchen, ...branchen, ...branchen].map((b) => <span>{b}</span>)}
    </div>
  </div>

  <section class="sektion" aria-labelledby="vn-t">
    <span class="deko d1" aria-hidden="true"></span>
    <div class="wrap">
      <span class="kicker reveal">Ein ganz normaler Montagmorgen</span>
      <h2 id="vn-t" class="reveal">Chaos im Gruppenchat. <span class="grad">Oder ein Tipp.</span></h2>
      <div class="vn">
        <div class="vn-box vorher reveal" data-r="l">
          <div class="vn-kopf"><span class="vn-tag schlecht">Heute</span><b>WhatsApp „Team Service"</b></div>
          <div class="chat" id="chat">
            <p class="msg ein"><i>Mia</i>Bin krank, kann heute nicht 🤒<time>06:02</time></p>
            <p class="msg chef"><i>Chef</i>Wer kann einspringen??<time>06:04</time></p>
            <p class="msg ein"><i>Tim</i>Ich nicht, bin beim Arzt<time>06:09</time></p>
            <p class="msg ein"><i>Sara</i>Hab die Kinder, sorry<time>06:15</time></p>
            <p class="msg chef"><i>Chef</i>Hallo?? Irgendjemand??<time>06:21</time></p>
            <p class="msg chef"><i>Chef</i>Ok, ich ruf jeden einzeln an …<time>06:40</time></p>
          </div>
          <p class="vn-fuss schlecht">😩 Schon 40 Minuten weg. Und noch kein Ersatz.</p>
        </div>
        <div class="vn-box nachher reveal" data-r="r">
          <div class="vn-kopf"><span class="vn-tag gut">Mit Schichtklar</span><b>Ihr Handy</b></div>
          <div class="chat" id="app">
            <p class="karte-n a1"><span>🔔</span><span><b>Mia hat sich krank gemeldet</b><br />Frühschicht heute, 06–14 Uhr</span></p>
            <p class="karte-n a2"><span>✨</span><span><b>Vorschlag: Lea</b><br />Hat frei, Ruhezeit passt, Stunden passen</span></p>
            <button class="btn" id="freigeben" type="button">Freigeben</button>
            <p class="karte-n a3 fertig" id="fertig"><span>✅</span><span><b>Lea ist informiert.</b><br />Plan aktualisiert. Fertig.</span></p>
          </div>
          <p class="vn-fuss gut">⚡ Ein Tipp. Ein paar Sekunden.</p>
        </div>
      </div>
      <p class="fussnote reveal">Beispielhafter Ablauf zur Veranschaulichung.</p>
    </div>
  </section>

  <section class="sektion" aria-labelledby="pl-t">
    <Hintergrund bild={handKalender} seite="rechts" deckkraft={0.22} />
    <div class="wrap">
      <span class="kicker reveal">Kennen Sie das?</span>
      <h2 id="pl-t" class="reveal">Drei Alltagsprobleme. <span class="grad">Drei einfache Lösungen.</span></h2>
      <div class="paare">
        {paare.map((x) => (
          <article class="paar reveal" data-r="s"><p class="problem">„{x.p}“</p><span class="pfeil" aria-hidden="true">↓</span><p class="loesung">{x.l}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="sektion" id="demo" aria-labelledby="demo-t">
    <Hintergrund bild={kalenderStift} seite="links" deckkraft={0.2} />
    <div class="wrap wrap-breit">
      <span class="kicker reveal">Die echte App zum Ausprobieren</span>
      <h2 id="demo-t" class="reveal">Sie als Chef. <span class="grad">Ihre Leute am Handy.</span></h2>
      <p class="lead reveal" style="margin-top:16px">Melden Sie Mia krank, beantragen Sie Urlaub, tauschen Sie Schichten und lassen Sie die KI offene Schichten füllen. Alles mit erfundenen Daten, aber genau so, wie es in der App läuft.</p>
      <div class="reveal" style="margin-top:34px"><DemoApp /></div>
    </div>
  </section>

  <section class="sektion" id="usp" aria-labelledby="usp-t">
    <span class="deko d1" aria-hidden="true"></span>
    <div class="wrap">
      <span class="kicker reveal">Unser Unterschied</span>
      <h2 id="usp-t" class="reveal">Ein Dienstplan, den Ihre Mitarbeiter <span class="grad">gern benutzen.</span></h2>
      <p class="lead reveal" style="margin-top:16px">Wer sich verstanden fühlt, meldet sich früher, tauscht fairer und bleibt länger. Darum ist Schichtklar zuerst für Ihre Mitarbeiter gebaut, und dadurch einfacher für Sie.</p>
      <h3 class="usp-ueber reveal">Für Mitarbeiter</h3>
      <div class="usp">
        <article class="karte reveal" data-r="s"><span class="symbol" aria-hidden="true">📱</span><h4>Plan sofort am Handy</h4><p>Nächste Schicht, Wochenplan und Stunden auf einen Blick. Kein Foto im Chat.</p></article>
        <article class="karte reveal" data-r="s"><span class="symbol" aria-hidden="true">🏖️</span><h4>Urlaub im Blick</h4><p>Antrag in wenigen Tippern. Anspruch, genommen, beantragt und Rest sieht jeder selbst.</p></article>
        <article class="karte reveal" data-r="s"><span class="symbol" aria-hidden="true">🤒</span><h4>Krank melden ohne Rechtfertigung</h4><p>Ein Tipp, keine Diagnose, kein Freitext. Danach der Hinweis zur AU und die Aufforderung, zusätzlich anzurufen, mit der Nummer der zuständigen Person.</p></article>
        <article class="karte reveal" data-r="s"><span class="symbol" aria-hidden="true">📊</span><h4>Eigene Krankheitstage</h4><p>Jeder sieht für sich, wie viele Krankheitstage es dieses Jahr waren. Nur für ihn selbst.</p></article>
        <article class="karte reveal" data-r="s"><span class="symbol" aria-hidden="true">🔁</span><h4>Fairer Schichttausch</h4><p>Tausch mit passenden, freien Kollegen. Die App warnt bei zu wenig Ruhezeit.</p></article>
        <article class="karte reveal" data-r="s"><span class="symbol" aria-hidden="true">🔒</span><h4>Privatsphäre</h4><p>Kollegen sehen bei Krank oder Urlaub nur „nicht verfügbar“. Nummern nur mit Einwilligung, jederzeit widerrufbar.</p></article>
      </div>
      <h3 class="usp-ueber reveal">Für Sie als Chef</h3>
      <div class="usp usp4">
        <article class="karte reveal" data-r="s"><span class="symbol" aria-hidden="true">✅</span><h4>Anfragen mit einem Tipp</h4><p>Tausch und Urlaub genehmigen oder ablehnen. Alle Beteiligten werden informiert.</p></article>
        <article class="karte reveal" data-r="s"><span class="symbol" aria-hidden="true">🩺</span><h4>Krankheitsausfälle sortiert</h4><p>Nach Dringlichkeit, mit AU-Status, Verlauf und Telefonnummer zum Anrufen.</p></article>
        <article class="karte reveal" data-r="s"><span class="symbol" aria-hidden="true">✨</span><h4>KI schlägt Schichten vor</h4><p>Offene Schichten werden mit passenden Kollegen vorbelegt. Sie prüfen und veröffentlichen. Die KI sieht nur Kürzel, keine Namen.</p></article>
        <article class="karte reveal" data-r="s"><span class="symbol" aria-hidden="true">⚖️</span><h4>Regelprüfung</h4><p>Warnt bei Ruhezeit, Pausen und Minijob-Grenze. Die Verantwortung bleibt bei Ihnen.</p></article>
      </div>
    </div>
  </section>

  <section class="sektion schritte" aria-labelledby="st-t">
    <span class="deko d2" aria-hidden="true"></span>
    <div class="wrap">
      <span class="kicker reveal">So starten Sie</span>
      <h2 id="st-t" class="reveal">Morgen schon <span class="grad">ohne Chaos.</span></h2>
      <div class="st-wrap">
        <div class="st-linie" aria-hidden="true"><i id="st-fill"></i></div>
        <ol class="st">
          <li class="reveal" data-r="s"><span class="nr">1</span><h3>Kurzes Gespräch</h3><p>Sie sagen mir, wie Ihr Betrieb läuft. Ich zeige Ihnen die App.</p></li>
          <li class="reveal" data-r="s"><span class="nr">2</span><h3>Ich richte alles ein</h3><p>Team, Schichten, Einladungen. Meist am selben Tag.</p></li>
          <li class="reveal" data-r="s"><span class="nr">3</span><h3>Plan aufs Handy</h3><p>Ihre Mitarbeiter sehen den Plan sofort. Sie tippen nur noch auf „Freigeben".</p></li>
        </ol>
      </div>
    </div>
  </section>


  <section class="sektion" aria-labelledby="mehr-t">
    <Hintergrund bild={bauplan} seite="rechts" deckkraft={0.3} />
    <div class="wrap">
      <span class="kicker reveal">Mehr als Dienstplan</span>
      <h2 id="mehr-t" class="reveal">Ich helfe auch <span class="grad">drumherum.</span></h2>
      <div class="mehr" style="margin-top:36px">
        {weitereLeistungen.map((w) => <article class="karte reveal"><h3>{w.titel}</h3><p>{w.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="sektion band-dunkel" id="rechner" aria-labelledby="r-t">
    <div class="wrap">
      <span class="kicker reveal">Der Preis von Chaos</span>
      <h2 id="r-t" class="reveal">Sie verballern jeden Monat Geld <span class="grad">mit Zettelwirtschaft.</span></h2>
      <p class="lead reveal" style="margin-top:16px">Anrufe um 6 Uhr, Umplanen, Nachfragen: Das ist bezahlte Zeit ohne einen Cent Umsatz. Stellen Sie Ihren Betrieb ein und sehen Sie die Zahl.</p>
      <div class="rechner reveal">
        <div class="regler">
          <div><label for="r-ma">Mitarbeiter <output id="o-ma">{std.standardMitarbeiter}</output></label><input id="r-ma" type="range" min="3" max="50" value={std.standardMitarbeiter} /></div>
          <div><label for="r-au">Ausfälle pro Woche <output id="o-au">{std.standardAusfaelle}</output></label><input id="r-au" type="range" min="0" max="20" value={std.standardAusfaelle} /></div>
          <div><label for="r-sa">Stundensatz in € <output id="o-sa">{String(std.stundensatz).replace(".", ",")}</output></label><input id="r-sa" type="range" min={std.mindestlohn} max="60" step="0.1" value={std.stundensatz} /></div>
        </div>
        <div class="ergebnis">
          <span class="e-kopf">Das verballern Sie jeden Monat:</span>
          <b id="e-eur" class="e-rot"><mark>0 €</mark></b>
          <span class="e-jahr">Das sind <b id="e-jahr">0 €</b> im Jahr und <b id="e-std">0 Std.</b> pro Monat, die Sie lieber für Ihre Gäste hätten.</span>
          <span class="e-vergleich">Schichtklar Basis für <span id="e-n">10</span> Mitarbeiter: <b id="e-preis">49 €</b> im Monat.</span>
          <small>Grobe, vorsichtige Schätzung mit Mindestlohn als Untergrenze. Annahmen: {std.planMinProMitarbeiterWoche} Min. pro Mitarbeiter und Woche, {std.minProAusfall} Min. pro Ausfall.</small>
        </div>
      </div>
    </div>
  </section>

    <section class="sektion" id="ehrlich" aria-labelledby="eh-t">
    <Hintergrund bild={bauplan} seite="rechts" deckkraft={0.18} />
    <span class="deko d2" aria-hidden="true"></span><span class="deko d1" aria-hidden="true"></span>
    <div class="wrap">
      <span class="kicker reveal">Was die App kann</span>
      <h2 id="eh-t" class="reveal">Jede Funktion spart Ihnen <span class="grad">Zeit und Nerven.</span></h2>
      <p class="lead reveal" style="margin-top:16px">Nur Dinge, die die App wirklich kann. Und was sie Ihnen und Ihrem Team im Alltag bringt.</p>
      <div class="eh">
        <div class="eh-box ja reveal" data-r="l">
          <h3>Für Sie als Inhaber</h3>
          <ul>
            <li><span><b>KI schlägt den Wochenplan vor.</b> Statt Zettel und Rechnerei prüfen Sie nur einen Entwurf. Nichts wird ohne Sie veröffentlicht.</span></li>
            <li><span><b>Ersatz bei Ausfall mit einem Tipp.</b> Die App zeigt freie, passende Kollegen mit genug Ruhezeit. Kein Rundruf mehr.</span></li>
            <li><span><b>Tausch und Urlaub in Sekunden entscheiden.</b> Alle Beteiligten werden automatisch informiert.</span></li>
            <li><span><b>Krankmeldungen sortiert.</b> Nach Dringlichkeit, mit AU-Status und Nummer zum Anrufen.</span></li>
            <li><span><b>„Heute“-Übersicht.</b> Wer da ist, wer fehlt, was offen ist. Ein Blick statt zehn Nachrichten.</span></li>
            <li><span><b>Woche kopieren, Vorlagen speichern.</b> Der Standardplan steht in einem Klick.</span></li>
            <li><span><b>Plan im eigenen Design.</b> Mit Ihrem Firmenlogo, Ihrer Farbe und einem zarten Logo-Wasserzeichen. Gedruckt sieht er aus wie von Ihnen.</span></li>
            <li><span><b>Regelprüfung und Lohn-Export.</b> Warnung bei Ruhezeit, Pausen und Minijob-Grenze. Stunden als CSV fürs Lohnbüro.</span></li>
          </ul>
        </div>
        <div class="eh-box ja reveal" data-r="r">
          <h3>Für Ihre Mitarbeiter</h3>
          <ul>
            <li><span><b>Plan immer am Handy.</b> Keine Nachfragen mehr nach der nächsten Schicht.</span></li>
            <li><span><b>Urlaub beantragen, Resturlaub sehen.</b> Ohne Zettel, ohne Frage beim Chef.</span></li>
            <li><span><b>Krank melden mit einem Tipp.</b> Keine Diagnose, kein Freitext. Danach der Hinweis auf die AU.</span></li>
            <li><span><b>„Bitte jetzt anrufen“ mit Nummer.</b> Die zuständige Person steht direkt da, damit niemand lange suchen muss.</span></li>
            <li><span><b>Eigene Krankheitstage im Blick.</b> Nur für den Mitarbeiter selbst sichtbar.</span></li>
            <li><span><b>Schichten tauschen.</b> Es werden nur freie, passende Kollegen vorgeschlagen.</span></li>
            <li><span><b>Datenschutz.</b> Kollegen sehen bei Urlaub und Krank nur „nicht verfügbar“. Daten in Frankfurt, Deutsch und Englisch.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sektion" id="preise" aria-labelledby="p-t">
    <span class="deko d3" aria-hidden="true"></span>
    <div class="wrap">
      <span class="kicker reveal">Preise</span>
      <h2 id="p-t" class="reveal">Der normale Preis. <span class="grad">Und was Sie jetzt sparen.</span></h2>
      <p class="lead reveal" style="margin-top:16px"><span class="tag" id="angebot" data-bis={preise.gruender.bis}>{preise.gruender.etikett}</span></p>
      <div class="p-regler reveal">
        <label for="p-ma">Wie viele Mitarbeiter hat Ihr Betrieb? <output id="p-o">{preise.regler.standard}</output></label>
        <input id="p-ma" type="range" min={preise.regler.min} max={preise.regler.max} value={preise.regler.standard} />
        <small>Basis: 5 € pro Mitarbeiter und Monat. Kleine Betriebe zahlen wenig.</small>
      </div>
      <div class="preise">
        {preise.pakete.map((p) => (
          <article class={`karte preis reveal ${p.hervorgehoben ? "top" : ""}`} data-paketpreis={p.id}>
            <h3>{p.name}</h3>
            <p>{p.untertitel}</p>
            <div class="alt-preis"><s class="p-reg">{p.regulaer}</s> <span>pro Monat</span></div>
            <div class="neu-preis">Jetzt nur <b class="p-neu">{p.gruender}</b> <span class="p-bis">bis {preise.gruender.kurzDatum}</span></div>
            <ul>{p.id !== "basis" && <li>Alles aus Basis</li>}{p.leistungen.map((l) => <li>{l}</li>)}</ul>
            <a class="btn" data-magnet href={`#kontakt`} data-paket={p.id}>{p.name} anfragen</a>
          </article>
        ))}
      </div>
      <p class="fussnote reveal">{preise.zusatz}. {steuerHinweis[preise.steuer]}</p>
    </div>
  </section>

  <section class="sektion" id="faq" aria-labelledby="f-t">
    <div class="wrap">
      <span class="kicker reveal">Fragen</span>
      <h2 id="f-t" class="reveal">Kurz <span class="grad">beantwortet.</span></h2>
      <div class="faq">
        {fragen.map((x) => <details class="reveal"><summary>{x.f}</summary><p>{x.a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="sektion band-dunkel" id="kontakt" aria-labelledby="k-t">
    <div class="wrap kontakt">
      <div class="direkt">
        <span class="kicker reveal">Kontakt</span>
        <h2 id="k-t" class="reveal">Lassen Sie uns <span class="grad">sprechen.</span></h2>
        <p class="lead reveal">Ich rufe Sie {kontakt.antwortFrist} zurück.</p>
        <a class="btn reveal" data-magnet href={whatsappHref} rel="noopener"><WaIcon />WhatsApp schreiben</a>
        <a class="btn leer reveal" href={telHref}>{kontakt.telefon}</a>
        <a class="btn leer reveal" href={mailHref}>{kontakt.email}</a>
        {demoLink.startsWith("http") && <a class="btn leer reveal" href={demoLink}>Live-Demo öffnen</a>}
      </div>
      <form class="formular reveal" id="anfrage-form" name="demo-anfrage" method="POST" action="/danke" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="demo-anfrage" />
        <p class="honig" aria-hidden="true"><label>Bitte nicht ausfüllen: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <label>Ihr Name<input name="name" type="text" required autocomplete="name" /></label>
        <label>Betrieb<input name="betrieb" type="text" required autocomplete="organization" /></label>
        <label>Telefon<input name="telefon" type="tel" required autocomplete="tel" inputmode="tel" /></label>
        <label>E-Mail (optional)<input name="email" type="email" autocomplete="email" /></label>
        <label>Interesse
          <select name="paket" id="f-paket">
            <option value="">Noch unsicher, beraten Sie mich</option>
            <option value="basis">Basis (Dienstplan)</option>
            <option value="plus">Plus (Dienstplan und laufende Hilfe)</option>
          </select>
        </label>
        <label>Zusatzinfos (optional)
          <textarea name="nachricht" rows="4" maxlength="1500" placeholder="z. B. Anzahl Mitarbeiter, wie Sie heute planen, was Ihnen wichtig ist"></textarea>
        </label>
        <label class="haken"><input type="checkbox" name="datenschutz" required /> <span>Ich habe die <a href="/datenschutz">Datenschutzerklärung</a> gelesen.</span></label>
        <p class="form-fehler" id="form-fehler" role="alert" hidden>Das Absenden hat gerade nicht geklappt. Bitte rufen Sie kurz an oder schreiben Sie per WhatsApp, dann kümmere ich mich sofort darum.</p>
        <button class="btn" type="submit">Rückruf anfordern</button>
      </form>
      <div class="form-ok" id="form-ok" role="status" aria-live="polite" tabindex="-1" hidden>
        <div class="form-ok-haken" aria-hidden="true">✓</div>
        <h3>Danke. Ich melde mich.</h3>
        <p>Ich rufe Sie {kontakt.antwortFrist} zurück. Ihre Angaben sind bei mir angekommen.</p>
        <p>Es eilt? Ich bin direkt erreichbar:</p>
        <a class="btn" href={telHref}>Jetzt anrufen: {kontakt.telefon}</a>
        <a class="btn leer" href={whatsappHref} rel="noopener"><WaIcon />WhatsApp schreiben</a>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <script type="application/json" id="cfg" set:html={JSON.stringify({ std, preiseCfg: preise.pakete.map((p) => ({ id: p.id, ...p.modell })) })} />
  <script>
    import { animate, stagger, inView, scroll } from "motion";
    const { std, preiseCfg } = JSON.parse(document.getElementById("cfg").textContent);
    const reduziert = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const $ = (s) => document.querySelector(s);

    /* --- Hero-Handy: kleine Geschichte in Dauerschleife --- */
    (async () => {
      const zeilen = [...document.querySelectorAll(".handy .zeile")].filter((z) => z.id !== "he");
      const hk = $("#hk"), he = $("#he"), ht = $("#ht");
      if (reduziert) { zeilen.forEach((z) => (z.style.opacity = 1)); return; }
            const warte = (s) => new Promise((r) => setTimeout(r, s * 1000));
      while (true) {
        hk.classList.remove("krank"); he.style.display = "none"; ht.style.opacity = 0;
        zeilen.forEach((z) => { z.style.opacity = 0; });
        await animate(zeilen, { opacity: [0, 1], transform: ["translateY(14px)", "translateY(0px)"] }, { delay: stagger(0.15), duration: 0.5 }).finished;
        await warte(1.2);
        hk.classList.add("krank"); hk.querySelector(".zeit").textContent = "Krank";
        await animate(hk, { transform: ["translateX(-6px)", "translateX(6px)", "translateX(0px)"] }, { duration: 0.4 }).finished;
        await warte(0.8);
        he.style.display = "flex"; he.classList.add("ersatz");
        await animate(he, { opacity: [0, 1], transform: ["translateY(14px) scale(.95)", "translateY(0px) scale(1)"] }, { duration: 0.5 }).finished;
        await animate(ht, { opacity: [0, 1], transform: ["translateY(20px) scale(.95)", "translateY(0px) scale(1)"] }, { duration: 0.5 }).finished;
        await warte(3);
        hk.querySelector(".zeit").textContent = "Früh 06–14";
        await animate([ht, he], { opacity: 0 }, { duration: 0.4 }).finished;
        he.classList.remove("ersatz");
      }
    })();

    /* --- Chat-Chaos gegen ein Tipp --- */
    (() => {
      const msgs = [...document.querySelectorAll("#chat .msg")];
      const a = [...document.querySelectorAll("#app .karte-n, #app #freigeben")].filter((e) => !e.classList.contains("fertig"));
      const fertig = document.getElementById("fertig"), knopf = document.getElementById("freigeben");
      if (reduziert) { msgs.concat(a).forEach((e) => (e.style.opacity = 1)); knopf.addEventListener("click", () => { fertig.style.opacity = 1; fertig.style.display = "flex"; }); return; }
      inView("#chat", () => {
        animate(msgs, { opacity: [0, 1], transform: ["translateY(16px) scale(.96)", "translateY(0px) scale(1)"] }, { delay: stagger(0.55), duration: 0.45 });
        animate(".vn-fuss.schlecht", { opacity: [0, 1] }, { delay: 0.55 * msgs.length + 0.2, duration: 0.5 });
        animate(a, { opacity: [0, 1], transform: ["translateY(16px)", "translateY(0px)"] }, { delay: stagger(0.5, { startDelay: 0.6 }), duration: 0.5 });
        animate(".vn-fuss.gut", { opacity: [0, 1] }, { delay: 2.2, duration: 0.5 });
      }, { amount: 0.4 });
      knopf.addEventListener("click", () => {
        knopf.style.display = "none"; fertig.style.display = "flex";
        animate(fertig, { opacity: [0, 1], transform: ["scale(.85)", "scale(1)"] }, { duration: 0.5, ease: [0.34, 1.56, 0.64, 1] });
      });
    })();

    /* --- Schritte: Linie füllt sich beim Scrollen --- */
    (() => {
      const fill = document.getElementById("st-fill"); if (!fill || reduziert) return;
      const quer = matchMedia("(min-width: 900px)").matches;
      scroll(animate(fill, { transform: quer ? ["scaleX(0)", "scaleX(1)"] : ["scaleY(0)", "scaleY(1)"] }, { ease: "linear" }), { target: document.querySelector(".st-wrap"), offset: ["start 75%", "end 65%"] });
    })();

    /* --- Preis nach Mitarbeitern --- */
    const modelle = Object.fromEntries(preiseCfg.map((p) => [p.id, p]));
    const eurGanz = (n) => Math.round(n).toLocaleString("de-DE") + " €";
    const eurFein = (n) => n.toLocaleString("de-DE", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €";
    const regPreis = (id, n) => modelle[id].grund + modelle[id].proMitarbeiter * n;
    const angebotAktiv = Date.now() < Date.parse($("#angebot").dataset.bis);
    function zeichnePreise() {
      const n = Number(pm.value); $("#p-o").textContent = n;
      document.querySelectorAll("[data-paketpreis]").forEach((k) => {
        const id = k.dataset.paketpreis, reg = regPreis(id, n);
        k.querySelector(".p-reg").textContent = eurGanz(reg);
        k.querySelector(".p-neu").textContent = eurFein(reg * modelle[id].angebotFaktor);
      });
    }
    const pm = $("#p-ma"); pm.addEventListener("input", zeichnePreise); zeichnePreise();

    /* --- Rechner --- */
    const ma = $("#r-ma"), au = $("#r-au"), sa = $("#r-sa");
    let anzeige = { std: 0, eur: 0 };
    function rechne() {
      $("#o-ma").textContent = ma.value; $("#o-au").textContent = au.value; $("#o-sa").textContent = String(sa.value).replace(".", ",");
      const std_ = (ma.value * std.planMinProMitarbeiterWoche / 60 + au.value * std.minProAusfall / 60) * std.wochenProMonat;
      const eur = std_ * sa.value;
      $("#e-n").textContent = ma.value; $("#e-preis").textContent = eurGanz(regPreis("basis", Number(ma.value)));
      if (reduziert) { anzeige = { std: std_, eur }; }
      else animate(anzeige, { std: std_, eur }, { duration: 0.6, ease: "easeOut", onUpdate: () => draw() });
      draw();
      function draw() { $("#e-std").textContent = Math.round(anzeige.std).toLocaleString("de-DE") + " Std."; $("#e-eur").firstChild.textContent = eurGanz(anzeige.eur); $("#e-jahr").textContent = eurGanz(anzeige.eur * 12); }
    }
    [ma, au, sa].forEach((i) => i.addEventListener("input", rechne));
    rechne();

    /* --- Angebot: echter Countdown, danach reguläre Preise --- */
    const tag = $("#angebot"), bis = Date.parse(tag.dataset.bis), jetzt = Date.now();
    if (jetzt >= bis) {
      tag.style.display = "none";
      document.querySelectorAll(".neu-preis").forEach((b) => (b.style.display = "none"));
      document.querySelectorAll(".p-reg").forEach((b) => (b.style.textDecoration = "none"));
    } else {
      const t = Math.ceil((bis - jetzt) / 864e5);
      tag.textContent += ` · noch ${t} ${t === 1 ? "Tag" : "Tage"}`;
    }


    /* --- Kontaktformular: Absenden ohne Seitenwechsel, Bestätigung direkt an Ort und Stelle --- */
    (() => {
      const form = document.getElementById("anfrage-form");
      if (!form) return;
      const ok = document.getElementById("form-ok");
      const fehler = document.getElementById("form-fehler");
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = form.querySelector("button[type=submit]");
        const text = btn.textContent;
        btn.disabled = true; btn.textContent = "Wird gesendet …"; fehler.hidden = true;
        try {
          const res = await fetch("/", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: new URLSearchParams(new FormData(form)).toString(),
          });
          if (!res.ok) throw new Error("Status " + res.status);
          form.hidden = true; ok.hidden = false; ok.focus();
        } catch (err) {
          fehler.hidden = false; btn.disabled = false; btn.textContent = text;
        }
      });
    })();

    /* --- Paket-Buttons wählen das Formularfeld vor --- */
    document.querySelectorAll("[data-paket]").forEach((a) => a.addEventListener("click", () => { $("#f-paket").value = a.dataset.paket; }));
  </script>
</Dunkel>
